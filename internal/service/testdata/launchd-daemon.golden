<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installed by `muster-agent install-service`. Re-run it after moving the binary or the config. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.getmuster.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/muster-agent</string>
		<string>run</string>
		<string>--config</string>
		<string>/home/deploy/.muster-agent/config.json</string>
	</array>
	<key>UserName</key>
	<string>deploy</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/home/deploy/.muster/bin:/home/deploy/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin</string>
		<key>HOME</key>
		<string>/home/deploy</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/home/deploy/.muster-agent/agent.log</string>
	<key>StandardErrorPath</key>
	<string>/home/deploy/.muster-agent/agent.log</string>
</dict>
</plist>
