{
  "relay": {
    "url": "wss://relay.getmuster.dev",
    "token": "mst_node_... (written by `muster-agent join`; never edit by hand)"
  },
  "identity": {
    "org_id": "org_...",
    "name": "prod-server-01"
  },
  "project": {
    "dir": "/opt/myapp",
    "mode": "muster"
  },
  "muster_path": "/usr/local/bin/muster",
  "allowed_commands": [
    "muster deploy",
    "muster status",
    "muster rollback",
    "muster logs",
    "muster history",
    "muster --version",
    "muster hooks verify"
  ],
  "allow_shell": false,
  "allow_plaintext": false,
  "cli_key_policy": "tofu",
  "reconnect_base_delay": "1s",
  "reconnect_max_delay": "60s"
}
